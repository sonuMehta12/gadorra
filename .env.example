# ---- app ----
APP_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# ---- database ----
DATABASE_URL=postgresql+psycopg://gradorra:gradorra@localhost:5435/gradorra

# ---- auth ----
JWT_SECRET=change-me-in-production
FORM_TOKEN_TTL_MINUTES=15

# ---- otp ----
# console = print to server log (no WhatsApp needed, use for local dev)
# whatsapp_text = free-form message, only works inside a 24h session window
# whatsapp_template = production, needs an approved authentication template
OTP_CHANNEL=whatsapp_template
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3

# ---- whatsapp ----
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=1355994020929287
WHATSAPP_BUSINESS_ACCOUNT_ID=1290804439764703
WHATSAPP_API_VERSION=v25.0

# ---- razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
WHATSAPP_TOKEN=
RAZORPAY_WEBHOOK_SECRET=

# ---- acknowledgement number: GPET26/UP75/48213 ----
ACK_EXAM_CODE=GPET26
ACK_STATE_PREFIX=UP
ACK_DIGITS=5

# ---- fees (in paise) ----
CURRENT_PHASE=PRE_LAUNCH
FEE_PRELAUNCH_PAISE=9900
FEE_POSTLAUNCH_PAISE=49900
FEE_POSTLAUNCH_DISCOUNTED_PAISE=29900

# ---- registration ----
REGISTRATION_EXPIRY_HOURS=48
WHATSAPP_ACK_CHANNEL=template
WHATSAPP_TEMPLATE_OTP=gpet_otp
WHATSAPP_TEMPLATE_ACK=gpet_acknowledgement
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_MIN_SECONDS_BETWEEN_MESSAGES=6
WHATSAPP_DAILY_UNIQUE_RECIPIENTS=250
WHATSAPP_AUTH_TEMPLATE_BUTTON=true
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=10
RATE_LIMIT_REGISTRATION=5
RATE_LIMIT_OTP=10
RATE_LIMIT_GLOBAL=100
BOT_CHECK_PROVIDER=none
BOT_CHECK_SECRET=
AUTO_INIT_DB=false

# ---- email (Microsoft 365 SMTP; swap for SES on AWS without a code change) ----
EMAIL_ENABLED=true
EMAIL_PROVIDER=console
EMAIL_FROM=info@gradorra.in
EMAIL_FROM_NAME=GPET 2026
EMAIL_REPLY_TO=info@gradorra.in
EMAIL_ATTACH_RECEIPT=true
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=info@gradorra.in
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
